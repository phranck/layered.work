{
  "name": "@layered/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The agent-facing server, a thin client over the API",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "node --conditions=development --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@layered/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
