{
  "name": "@layered/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The design token system: scales, palette, semantic tokens, workbench density",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./src/index.css",
    "./*.css": "./src/*.css"
  },
  "scripts": {
    "build": "node scripts/derive.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ]
}
