{
  "name": "@layered/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The shared components, used by the website and by the dashboard",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.css": "./src/*.css",
    "./copy-assets": "./copy-assets.mjs",
    "./model-viewport": {
      "types": "./src/model-viewport.ts",
      "development": "./src/model-viewport.ts",
      "default": "./dist/model-viewport.js"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "development": "./src/icons.ts",
      "default": "./dist/icons.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@layered/content": "workspace:*",
    "@layered/tokens": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^3.2.7"
  },
  "sideEffects": [
    "*.css"
  ]
}
