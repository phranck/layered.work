version = 1

[project]
name = 'layered.work'

[runtime]
start_timeout = '60s'
probe_interval = '250ms'
health_timeout = '2s'
shutdown_timeout = '10s'
log_tail_lines = 20

[[services]]
name = 'backend'
command = 'pnpm --filter @layered/backend dev'
role = 'backend'
port = 4002
host = 'localhost'
health_path = '/health'

[[services]]
name = 'website'
command = 'pnpm --filter @layered/website dev'
role = 'website'
port = 3002
host = 'localhost'
health_path = '/health'
