# The local services. `grat status` before starting anything, because a service
# is often already running and starting a second one takes the port.
SERVICES=(backend website dashboard)
PORTS=(4310 3310 4510)
COMMANDS=(
  "pnpm --filter @layered/backend dev"
  "pnpm --filter @layered/website dev"
  "pnpm --filter @layered/dashboard dev"
)
