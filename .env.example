# Copy to .env.local. Nothing here is a secret; a secret has an empty value and
# is filled in locally, and in production every value comes from Zerops.

NODE_ENV=development

# The three local surfaces. The ports match grat.config.
BACKEND_PORT=4310
WEBSITE_PORT=3310
DASHBOARD_PORT=4510

SITE_ORIGIN=http://localhost:3310
DASHBOARD_ORIGIN=http://localhost:4510
API_URL=http://localhost:4310

# The local database. It has to be running already: nothing in this project
# starts a service you did not start. A missing value is an error rather than a
# reason to fall back to anything hosted.
DATABASE_URL=postgresql://layered@localhost:5432/layered

# Signs the session cookie. Any long random string locally.
SESSION_SECRET=

# The media bucket. Empty locally means uploads are written to ./media-local
# instead of to object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail. Empty means sending is disabled and the dashboard says so.
SMTP2GO_API_KEY=
EMAIL_FROM=
