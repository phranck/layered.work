# Copy to .env.local, which is never committed. The services read it themselves
# through Node's --env-file-if-exists, so nothing has to be exported into a
# shell before `grat start` works.
#
# Nothing here is a secret. A secret has an empty value and is filled in
# locally, and in production every value comes from Zerops.

NODE_ENV=development

# How much the API says. `trace`, `debug`, `info`, `warn`, `error`, `fatal` or
# `silent`, and `info` when nothing is set, which is one line per request.
LOG_LEVEL=debug

# The addresses the surfaces answer at locally. The ports come from grat.config,
# which is where they are decided: grat sets PORT itself for each service and
# does not allow it to be named anywhere else, so these are only the URLs one
# surface needs to reach another.
SITE_ORIGIN=http://localhost:3002
DASHBOARD_ORIGIN=http://localhost:4502
API_URL=http://localhost:4002

# The local database, which `docker compose up -d` brings up. The role, the
# password and the port are the ones compose.yml and scripts/local-database/
# create. A missing value is an error rather than a reason to fall back to
# anything hosted.
#
# layered_app is deliberately not a superuser, and the migration runner refuses
# to run as one. Neither password is a secret: the database listens on this
# laptop's loopback address alone and holds nothing that is not reproducible
# from the Publii export.
DATABASE_URL=postgres://layered_app:layered_local@127.0.0.1:5434/layered

# Where the suite writes. A database of its own, so a test can empty a table
# without any care about what else is in there, and so nothing a test does can
# reach the one being worked in. `docker compose up -d` creates it.
DATABASE_URL_TEST=postgres://layered_app:layered_local@127.0.0.1:5434/layered_test

# The role the migration runner insists on. It always refuses a superuser;
# naming one here makes it refuse anything else as well, so a migration cannot
# leave the schema owned by whoever happened to be connected.
DATABASE_EXPECTED_ROLE=layered_app

# The administrative role, for creating roles and looking around. Nothing that
# runs uses it.
# DATABASE_ADMIN_URL=postgres://layered:layered_local@127.0.0.1:5434/layered

# The one account the site starts with, created by `pnpm --filter @layered/backend
# db:seed`. It refuses to run when the table already holds somebody, so these can
# stay here without rewriting a password later. Choose your own before running it.
SEED_EMAIL=phranck@layered.work
SEED_NAME=phranck
SEED_PASSWORD=

# Signs the session cookie. Any long random string locally.
SESSION_SECRET=

# The media bucket. Empty locally means uploads are written to ./media-local
# instead of to object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail. Empty means sending is disabled and the dashboard says so.
SMTP2GO_API_KEY=
EMAIL_FROM=
