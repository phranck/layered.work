{
  "name": "layered-work",
  "private": true,
  "type": "module",
  "description": "The website and the editorial dashboard for layered.work",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "preview:website": "pnpm --filter @layered/website... build && node apps/website/tools/render-preview.mjs",
    "preview:refresh": "pnpm --filter @layered/website... build && node apps/website/tools/refresh-preview.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:publii",
    "test:publii": "pnpm --filter @layered/content... build && python3 -m unittest discover -s scripts/publii -p 'test_*.py' && node --test scripts/publii/*.test.mjs",
    "lint": "biome check . && pnpm lint:astro",
    "lint:astro": "prettier --check \"{apps,packages}/**/*.astro\"",
    "lint:fix": "biome check --write . && pnpm format:astro",
    "format": "biome format --write . && pnpm format:astro",
    "format:astro": "prettier --write \"{apps,packages}/**/*.astro\"",
    "db:reset": "pnpm --filter @layered/backend db:reset"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@biomejs/biome": "2.4.8",
    "@types/node": "^22.10.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "^5.9.3"
  }
}
