{
  "name": "layered-work",
  "private": true,
  "type": "module",
  "description": "The website and the editorial dashboard for layered.work",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "preview:website": "pnpm --filter @layered/website... build && node apps/website/tools/render-preview.mjs",
    "preview:refresh": "pnpm --filter @layered/website... build && node apps/website/tools/refresh-preview.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:migration",
    "test:migration": "node --test scripts/publii/*.test.mjs && python3 -m unittest discover -s scripts/publii -p 'test_*.py'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@biomejs/biome": "2.4.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
