{
  "name": "@layered/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The API on api.layered.work",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/copy-social-assets.mjs",
    "dev": "tsx --env-file-if-exists=../../.env.local --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:import": "tsx --env-file-if-exists=../../.env.local src/db/import.ts",
    "db:import-variants": "tsx --env-file-if-exists=../../.env.local src/db/import-variants.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/db/migrate.ts",
    "db:reset": "node ../../scripts/reset-database.mjs",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/db/seed.ts",
    "db:snapshot": "tsx --env-file-if-exists=../../.env.local src/db/write-snapshot.ts",
    "db:verify": "tsx --env-file-if-exists=../../.env.local src/db/verify.ts",
    "db:verify-bucket": "tsx --env-file-if-exists=../../.env.local src/db/verify-bucket-cli.ts",
    "db:sync-media": "tsx --env-file-if-exists=../../.env.local src/db/sync-media-cli.ts",
    "test": "node --test ../../scripts/backend-deploy.test.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@layered/content": "workspace:*",
    "@layered/passwords": "workspace:*",
    "@layered/policy": "workspace:*",
    "@layered/schemas": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "0.29.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
