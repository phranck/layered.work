{
  "name": "@layered/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The API on api.layered.work",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=../../.env.local --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@layered/policy": "workspace:*",
    "@layered/schemas": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
