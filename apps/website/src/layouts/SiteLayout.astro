---
import { CONTENT_LOCALES, type ContentLanguage, LANGUAGE_ROOTS, type ReadingWidth } from "@layered/schemas";
import "@layered/tokens/index.css";
import "@layered/ui/base.css";
import "@layered/ui/index.css";
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { SiteFooterData, SiteNavigationItem } from "../components/site-navigation";
import type { LanguageLink } from "../content/language-links";
import type { SocialImage } from "../content/metadata";
import { TAGLINE } from "../site";

interface Props {
  title: string;
  description?: string;
  language?: ContentLanguage;
  canonicalPath?: string;
  translationPath?: string | null;
  alternates?: LanguageLink[];
  readingWidth?: ReadingWidth;
  navigation?: SiteNavigationItem[];
  footer?: SiteFooterData;
  siteName?: string;
  socialImage?: SocialImage;
  article?: Record<string, unknown>;
  /**
   * The picture a reader sees first, which the head asks for ahead of the
   * fonts, so it arrives alongside the document rather than after it has been
   * read. It has to name the candidates and widths the page's `img` names, or
   * the browser fetches the picture twice.
   */
  leadImage?: { src: string; srcSet?: string; sizes?: string };
}

const {
  title,
  description = TAGLINE,
  language = "en",
  canonicalPath = Astro.url.pathname,
  translationPath = null,
  alternates = [],
  readingWidth = "normal",
  navigation = [],
  footer = {},
  siteName = "LAYERED.work",
  socialImage = { url: "https://layered.work/og.png", width: 1200, height: 630, alt: "LAYERED.work" },
  article,
  leadImage,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? "https://layered.work");
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang={language} data-reading-width={readingWidth}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={CONTENT_LOCALES[language].replace("-", "_")} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:alt" content={socialImage.alt} />
    {socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    {article && (
      <script
        is:inline
        type="application/ld+json"
        nonce={Astro.locals.nonce}
        set:html={JSON.stringify(article).replace(/</g, "\\u003c")}
      />
    )}
    <link rel="canonical" href={canonical} />
    {alternates.map((link) => (
      <link rel="alternate" hreflang={link.language} href={new URL(link.path, canonical)} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL(`${LANGUAGE_ROOTS[language]}feed.xml`, canonical)}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={siteName}
      href={new URL(`${LANGUAGE_ROOTS[language]}feed.json`, canonical)}
    />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {leadImage && (
      <link
        rel="preload"
        as="image"
        href={leadImage.src}
        imagesrcset={leadImage.srcSet}
        imagesizes={leadImage.sizes}
        fetchpriority="high"
      />
    )}
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {language === "de" ? "Zum Inhalt springen" : "Skip to content"}
    </a>
    <SiteHeader {language} {siteName} {navigation} {translationPath} />
    <main class="page" id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter {language} {siteName} {footer} />
  </body>
</html>
