---
/**
 * The home page.
 *
 * A placeholder, and the one the switch reveals at the launch moment. Whatever
 * stands here at the configured launch moment is what the world sees, so it says what
 * it is rather than pretending. The real home page is assembled from blocks out
 * of the database and is its own issue.
 *
 * Shared React compounds render on the server. No client directive is needed
 * for this static page, so React does not hydrate it in the browser.
 */
import { Card, Logo, Row, Section } from "@layered/ui";
import { createElement } from "react";
import "@layered/tokens/index.css";
import "@layered/ui/base.css";
import "@layered/ui/index.css";
import { COPY, DESCRIPTION, SITE_ORIGIN } from "../site.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{COPY.logoLabel} | {COPY.tagline}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE_ORIGIN}/`} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts.css" />
  </head>
  <body>
    <main class="ui-placeholder">
      <Section>
        <Section.Title title={createElement(Logo, { href: "/", label: COPY.logoLabel })} level={1} />
        <Section.Body>
          <Card>
            <Card.Header title={COPY.tagline} />
            <Card.Body>
              <Row>
                <Row.Text title={COPY.body[0]} note="This page is being built." />
              </Row>
            </Card.Body>
          </Card>
        </Section.Body>
      </Section>
    </main>
  </body>
</html>
