<script>
  import { activateVisibleModels } from "@layered/ui/model-island";
  import { initializeModelViewports } from "@layered/ui/model-viewport";
  import focusStyles from "@layered/ui/focus.css?inline";

  initializeModelViewports();
  activateVisibleModels(async () => {
    const { ModelViewerElement } = await import("@google/model-viewer");
    // Configure local decoders before exposing a visible model's source.
    ModelViewerElement.dracoDecoderLocation = "/draco/";
    ModelViewerElement.ktx2TranscoderLocation = "/basis/";
    const sheet = new CSSStyleSheet();
    sheet.replaceSync(focusStyles);
    document.querySelectorAll("model-viewer").forEach((model) => {
      if (model.shadowRoot) {
        model.shadowRoot.adoptedStyleSheets = [...model.shadowRoot.adoptedStyleSheets, sheet];
      }
    });
  });
</script>
