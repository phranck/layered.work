---
/**
 * What a protected entry shows instead of itself.
 *
 * It names nothing about the entry: no title, no summary, no topics, no date.
 * The address is already known to whoever typed it, and everything else is what
 * the password protects.
 */
import { MAX_PASSWORD_LENGTH } from "@layered/schemas";
import { Button, Card, Field, Input, Section } from "@layered/ui";
import { LockKeyIcon } from "@layered/ui/icons";
import { createElement } from "react";
import type { UnlockRefusal } from "../content/unlock.js";

interface Props {
  /** Whether the page speaks German. */
  de: boolean;
  /** Why the last attempt was refused, when there was one. */
  refusal?: UnlockRefusal;
}

const { de, refusal } = Astro.props;

const title = de ? "Dieser Beitrag ist geschützt" : "This entry is protected";
const lead = de ? "Gib das Passwort ein, um ihn zu lesen." : "Enter the password to read it.";
const messages: Record<UnlockRefusal, string> = de
  ? {
      wrong: "Das Passwort stimmt nicht.",
      "too-many": "Zu viele Versuche. Bitte warte ein paar Minuten.",
      unavailable: "Der Beitrag lässt sich gerade nicht öffnen. Bitte versuche es später noch einmal.",
    }
  : {
      wrong: "That password is not right.",
      "too-many": "Too many attempts. Please wait a few minutes.",
      unavailable: "This entry cannot be opened right now. Please try again later.",
    };
---

<Section.Page>
  <div class="password-gate">
    <Card>
      <Card.Header eyebrow={createElement(LockKeyIcon, { weight: "duotone" })} title={title} />
      <Card.Body>
        <p class="password-gate__lead">{lead}</p>
        {refusal && <p class="password-gate__error" role="alert">{messages[refusal]}</p>}
        <form method="post" class="password-gate__form">
          <Field label={de ? "Passwort" : "Password"} htmlFor="entry-password">
            <Input
              id="entry-password"
              name="password"
              type="password"
              autoComplete="current-password"
              maxLength={MAX_PASSWORD_LENGTH}
              required
            />
          </Field>
          <Button type="submit" tone="primary">{de ? "Lesen" : "Read"}</Button>
        </form>
      </Card.Body>
    </Card>
  </div>
</Section.Page>
