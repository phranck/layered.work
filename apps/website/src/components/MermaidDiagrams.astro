<script>
  const diagrams = Array.from(document.querySelectorAll<HTMLElement>('[data-mermaid-diagram]'));
  if (diagrams.length) {
    const german = document.documentElement.lang === 'de';
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      renderDiagrams();
    }, { rootMargin: '200px' });
    diagrams.forEach(diagram => observer.observe(diagram));

    async function renderDiagrams() {
      try {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          suppressErrorRendering: true,
          theme: 'dark',
          htmlLabels: false,
          flowchart: { htmlLabels: false },
          // `theme` is locked with the rest: a diagram carried over from the old
          // site may name one of its own, and Mermaid's light themes draw the
          // links and arrowheads in black, which is invisible on this page. What
          // a diagram says about its own nodes, through classDef and style, is
          // content and still applies.
          secure: ['securityLevel', 'startOnLoad', 'htmlLabels', 'suppressErrorRendering', 'secure', 'theme'],
        });
        await document.fonts.ready;
        await Promise.all(diagrams.map(async diagram => {
          const source = diagram.querySelector<HTMLTemplateElement>('template[data-mermaid-source]')?.content.textContent;
          const output = diagram.querySelector<HTMLElement>('[data-mermaid-output]');
          if (!source || !output) return;
          const id = `diagram-${crypto.randomUUID()}`;
          const scratch = document.createElement('div');
          scratch.style.position = 'absolute';
          scratch.style.visibility = 'hidden';
          document.body.append(scratch);
          try {
            const { svg } = await mermaid.render(id, source, scratch);
            const image = new Image();
            image.alt = german ? 'Diagramm' : 'Diagram';
            // An image keeps the SVG self-contained and cannot execute embedded scripts.
            image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
            await image.decode();
            output.replaceChildren(image);
            diagram.dataset.rendered = 'true';
          } catch (error) {
            showFailure(output, error);
          } finally {
            scratch.remove();
          }
        }));
      } catch (error) {
        diagrams.forEach(diagram => {
          const output = diagram.querySelector<HTMLElement>('[data-mermaid-output]');
          if (output) showFailure(output, error);
        });
      }
    }
    function showFailure(output: HTMLElement, error: unknown) {
      const message = document.createElement('p');
      message.setAttribute('role', 'alert');
      message.textContent = german ? 'Das Diagramm konnte nicht dargestellt werden.' : 'The diagram could not be rendered.';
      output.replaceChildren(message);
      console.error('MERMAID_RENDER_FAILED', error instanceof Error ? error.name : 'UnknownError');
    }
  }
</script>
