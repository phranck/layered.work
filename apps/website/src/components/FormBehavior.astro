<!-- The native POST remains the fallback. This script only replaces the form in place. -->
<script>
  function validateChoiceGroups(form: HTMLFormElement): void {
    const message =
      form.querySelector<HTMLInputElement>('input[name="_language"]')?.value === "de"
        ? "Bitte wähle mindestens eine Option."
        : "Select at least one option.";
    for (const group of Array.from(
      form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-required-choice="true"]'),
    )) {
      const choices = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      choices[0]?.setCustomValidity(choices.some((choice) => choice.checked) ? "" : message);
    }
  }

  document.addEventListener("change", (event) => {
    if (event.target instanceof HTMLInputElement) {
      const form = event.target.closest<HTMLFormElement>("form[data-form-name]");
      if (form) validateChoiceGroups(form);
    }
  });

  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("form[data-form-name]")) return;
    event.preventDefault();
    validateChoiceGroups(form);
    if (!form.reportValidity()) return;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "text/html" },
      });
      const html = new DOMParser().parseFromString(await response.text(), "text/html");
      const name = form.dataset.formName;
      const replacement = name ? html.querySelector(`[data-form-name="${CSS.escape(name)}"]`) : null;
      if (!replacement) throw new Error("The response did not contain the form.");
      form.replaceWith(document.importNode(replacement, true));
    } catch {
      if (submit) submit.disabled = false;
      const error = document.createElement("p");
      error.className = "form-controls__error";
      error.setAttribute("role", "alert");
      error.textContent =
        form.querySelector<HTMLInputElement>('input[name="_language"]')?.value === "de"
          ? "Senden fehlgeschlagen. Bitte versuche es erneut."
          : "Sending failed. Please try again.";
      form.append(error);
    }
  });
</script>
