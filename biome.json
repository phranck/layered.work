{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/*.astro",
      "!**/drizzle",
      "!prototype",
      "!.issues",
      "!apps/website/content",
      "!apps/website/public/draco",
      "!apps/website/public/basis",
      "!migration-out"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "recommended": true
      },
      "suspicious": {
        "recommended": true
      },
      "a11y": {
        "recommended": true
      }
    }
  }
}
